{
  "name": "nafis-demo",
  "private": true,
  "version": "0.1.0",
  "description": "Concept demo of an AI-native NAFIS platform with nine portals. Static front-end, fictional sample data. Not an official NAFIS or UAE Government service.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "check:figures": "node scripts/check-figures.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:figures && npm run build",
    "test:smoke": "playwright test"
  },
  "dependencies": {
    "@fontsource/alexandria": "^5.1.0",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/noto-kufi-arabic": "^5.1.0",
    "@fontsource/roboto": "^5.1.0",
    "@fontsource/roboto-mono": "^5.1.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5"
  }
}
